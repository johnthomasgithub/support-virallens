# development | production
# production => secure + SameSite=None cookies (client and API on different domains),
# JSON logs, no stack traces in responses, JWT_SECRET required.
NODE_ENV=development
PORT=5000

# Local MongoDB, or your Atlas connection string:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-support-agent?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai-support-agent

# REQUIRED in production: random string, 32+ chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend origin(s) allowed by CORS. Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173

# REQUIRED: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional: tried automatically if the primary model fails
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Number of reverse proxies in front of the API (Render/Railway = 1). Defaults to 1 in production, 0 otherwise.
# Use 2 when the client also proxies the API (Vercel /api rewrite → Render).
# TRUST_PROXY=1

# Cookie SameSite policy. Default: none in production (cross-domain), lax in development.
# Use lax in production when the API is served under the client's domain via a proxy/rewrite.
# COOKIE_SAMESITE=lax
